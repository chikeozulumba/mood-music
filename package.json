{
  "name": "mood-music",
  "private": true,
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,magenta \"pnpm --filter web dev\" \"pnpm --filter api dev\"",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm --filter web build && pnpm --filter api build",
    "deploy": "pnpm build && pnpm --filter api deploy",
    "cf-typegen": "pnpm --filter api cf-typegen"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
